{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "mongoose": ["./node_modules/mongoose"],
      "stripe": ["./node_modules/stripe"]
    },
    "outDir": ".vercel/output/functions",
    "rootDir": "."
  },
  "include": ["api/**/*", "backend/src/**/*"]
}
